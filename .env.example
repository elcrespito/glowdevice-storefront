# Public Shopify store domain (catalog)
SHOPIFY_STORE_DOMAIN=zeroid-2.myshopify.com
# Admin/OAuth host — MUST be *.myshopify.com for client_credentials
SHOPIFY_SHOP_DOMAIN=zeroid-2.myshopify.com

# 2026+ Dev Dashboard app (preferred): Client ID + Secret → client_credentials → 24h token
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Legacy only: static Admin API token (shpat_...) from old admin custom apps
# SHOPIFY_ADMIN_TOKEN=

SHOPIFY_ADMIN_API_VERSION=2026-07

# Shared HMAC secret with peptidemy.com (Pay via ZEROID handoff)
GLOW_HANDOFF_SECRET=

# Optional: Storefront API token for catalog cart permalinks (/go)
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# This storefront's public URL
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Peptidemy return URL (redirect after payment)
PEPTIDEMY_RETURN_URL=https://peptidemy.com

# Shopify webhook secret (from Shopify Admin → Settings → Notifications → Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# Optional: Peptidemy webhook URL (to notify about completed payments)
PEPTIDEMY_WEBHOOK_URL=https://peptidemy.com/api/webhooks/zeroid
