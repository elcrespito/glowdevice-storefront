# Public Shopify store that owns catalog + checkout
SHOPIFY_STORE_DOMAIN=glowdevice.shop

# Optional: Storefront API token for cartCreate → checkoutUrl
# Create in Shopify Admin → Settings → Apps → Develop apps → Storefront API
# Scopes: unauthenticated_read_product_listings, unauthenticated_write_checkouts
SHOPIFY_STOREFRONT_TOKEN=

# Optional override for Storefront API version
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# This mirror storefront's public URL (used in cart attributes / notes)
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
