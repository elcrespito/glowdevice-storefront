# Public Shopify store domain (catalog)
SHOPIFY_STORE_DOMAIN=zeroid-2.myshopify.com
# Admin/OAuth host — MUST be *.myshopify.com for client_credentials
SHOPIFY_SHOP_DOMAIN=zeroid-2.myshopify.com

# 2026+ Dev Dashboard app (preferred): Client ID + Secret → client_credentials → 24h token
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Legacy only: static Admin API token (shpat_...) from old admin custom apps
# SHOPIFY_ADMIN_TOKEN=

SHOPIFY_ADMIN_API_VERSION=2026-07

# Shared HMAC secret with peptidemy.com.
# Used both for the signed Pay via ZEROID handoff and the signed payment callback.
# IMPORTANT: use the exact same value on glowdevice-storefront and peptidemy.com.
GLOW_HANDOFF_SECRET=

# Optional: Storefront API token for catalog cart permalinks (/go)
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# This storefront's public URL
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Peptidemy return URL (used in Shopify draft-order metadata; custom Thank You button comes later)
PEPTIDEMY_RETURN_URL=https://peptidemy.com

# Shopify orders/paid webhook HMAC secret.
# For Dev Dashboard app webhooks this is the app secret; if omitted, code falls back to SHOPIFY_CLIENT_SECRET.
SHOPIFY_WEBHOOK_SECRET=

# Server-to-server callback after Shopify reports orders/paid.
# The callback is HMAC-SHA256 signed with GLOW_HANDOFF_SECRET.
PEPTIDEMY_WEBHOOK_URL=https://peptidemy.com/api/webhooks/zeroid
