# Public Shopify store domain (catalog + draft orders shop)
SHOPIFY_STORE_DOMAIN=glowdevice.shop
# Same as above for Admin API host (myshopify.com preferred if different)
SHOPIFY_SHOP_DOMAIN=glowdevice.shop

# Admin API access token from a custom app on glowdevice
# Scopes: write_draft_orders, read_draft_orders, read_orders, write_orders
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2024-10

# Shared HMAC secret with peptides.my (Pay via Glow handoff)
GLOW_HANDOFF_SECRET=

# Optional: Storefront API token for catalog cart permalinks (/go)
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# This mirror storefront's public URL
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
